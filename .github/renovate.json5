{
  extends: [
    'config:recommended',
  ],
  enabledManagers: [
    'gradle',
    'gradle-wrapper',
    'github-actions',
  ],
  labels: [
    'dependencies',
  ],
  prHourlyLimit: 3,
  packageRules: [
    {
      matchManagers: [
        'gradle-wrapper',
      ],
      automerge: true,
    },
    {
      matchDatasources: [
        'maven',
      ],
      depType: 'dependencies',
      registryUrls: [
        'https://repo.maven.apache.org/maven2/',
        'https://plugins.gradle.org/m2',
      ],
      automerge: true,
    },
  ],
}
